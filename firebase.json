{
  "functions": {
    "source": "functions",
    "python": {
      "runtime": "python39"
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "predict"
      },
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ]
  }
}
